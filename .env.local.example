# Strava credentials for the /running ticker.
# Copy this file to `.env.local` (gitignored) and fill in real values.
# The refresh token MUST be granted `activity:read_all` scope, otherwise
# private ("Only You") runs are excluded and the totals undercount.
# These are server-side only — do NOT add a NEXT_PUBLIC_ prefix.

# Numeric ID of your Strava API app, from https://www.strava.com/settings/api.
STRAVA_CLIENT_ID=

# The app's secret from the same page — it proves token requests come from your app.
STRAVA_CLIENT_SECRET=

# Long-lived token that lets the site get short-lived access tokens for your
# account. Only the starting value: newer tokens are stored in the database.
STRAVA_REFRESH_TOKEN=

# Your numeric athlete ID (the number in your strava.com/athletes/<id> URL);
# the webhook ignores events from any other athlete.
STRAVA_ATHLETE_ID=

# Postgres connection string (Neon). In Vercel this is set automatically when
# the Neon database is connected to the project; copy it here for local dev.
DATABASE_URL=

# Any random string you choose (e.g. `openssl rand -hex 16`). Strava sends it
# back when you register the webhook, proving the request came from you.
STRAVA_VERIFY_TOKEN=
